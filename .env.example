# ── ahc-low-female-hormone-perimenopause ──────────────────────────────────
# v0 (MVP) runs entirely client-side with localStorage persistence and needs
# NONE of these to build or run. They are listed here for the v1 wiring that is
# tracked in PARKING_LOT.md.

# Supabase (project: ajax-harwood-clinic) — tables use the mpz_ prefix
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email for "email the packet to yourself" (Resend in sibling repos)
RESEND_API_KEY=
PACKET_FROM_EMAIL=

# App version stamped onto outputs and stored rows
NEXT_PUBLIC_APP_VERSION=0.1.0
